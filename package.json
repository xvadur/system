{
  "name": "@xvadur/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Verziovaný dizajnový systém a komponenty XVADUR",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvadur/system.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./src/styles/components.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "registry.json",
    "tsconfig.lib.json",
    "README.md",
    "CHANGELOG.md",
    "licenses",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "npm run build:lib && astro dev --host 127.0.0.1 --port 4390",
    "build:lib": "tsc -p tsconfig.lib.json",
    "build:catalog": "astro build",
    "build": "npm run build:lib && npm run build:catalog",
    "check": "tsc -p tsconfig.lib.json --noEmit && astro check && node scripts/check-registry.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "verify": "npm run build:lib && npm run check && npm test && npm run build:catalog && npm run test:consumer",
    "prepare": "npm run build:lib",
    "version:next": "node scripts/version.mjs",
    "dev:stack": "npm run dev",
    "preview": "astro preview --host 127.0.0.1 --port 4390"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

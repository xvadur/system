---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import { readDennik } from '../lib/data.js';

const dennik = readDennik();
---

<Layout title="Denník">
  <h1>Denník <span class="muted">· {dennik.length} dní</span></h1>

  {dennik.length === 0 ? (
    <p class="panel prazdne">
      Zatiaľ žiadne záznamy. Nový deň = nový súbor <code>data/dennik/RRRR-MM-DD.md</code>
      (šablóna: <code>data/dennik/_sablona.md</code>).
    </p>
  ) : (
    <div style="display:grid; gap:0.9rem;">
      {dennik.map((z) => (
        <div class="panel">
          <strong style="font-size:1.05rem;">{z.datum}</strong>
          <div style="margin-top:0.5rem;">
            {z.kalorie != null && <span class="chip">kalórie <b>{z.kalorie}</b></span>}
            {z.spanok != null && <span class="chip">spánok <b>{z.spanok} h</b></span>}
            {z.meditacia != null && <span class="chip">meditácia <b>{z.meditacia} min</b></span>}
            {z.cvicenie && <span class="chip">cvičenie <b>{z.cvicenie}</b></span>}
            {z.kalorie == null && z.spanok == null && z.meditacia == null && !z.cvicenie && (
              <span class="prazdne">bez metrík</span>
            )}
          </div>
          {z.body && <article class="md" set:html={marked.parse(z.body)} />}
        </div>
      ))}
    </div>
  )}
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { readPoznamky } from '../../lib/data.js';

const poznamky = readPoznamky();
---

<Layout title="Poznámky">
  <h1>Poznámky <span class="muted">· {poznamky.length}</span></h1>

  <input
    type="search"
    id="filter"
    placeholder="Filtrovať poznámky..."
    style="width:100%; max-width:24rem; background:var(--panel); border:1px solid var(--border); border-radius:8px; color:var(--text); padding:0.5rem 0.7rem; font:inherit; margin-bottom:1rem;"
  />

  {poznamky.length === 0 ? (
    <p class="panel prazdne">
      Zatiaľ žiadne poznámky. Nová poznámka = nový súbor <code>data/poznamky/nazov.md</code>.
    </p>
  ) : (
    <div class="mriezka" id="zoznam">
      {poznamky.map((p) => (
        <a
          href={`/poznamky/${p.slug}`}
          class="panel poznamka"
          style="text-decoration:none; color:inherit;"
          data-text={`${p.nazov} ${p.tagy.join(' ')} ${p.body}`.toLowerCase()}
        >
          <strong>{p.nazov}</strong>
          <div class="muted" style="font-size:0.82rem; margin:0.2rem 0 0.4rem;">{p.datum}</div>
          <div>{p.tagy.map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      ))}
    </div>
  )}

  <script>
    const filter = document.getElementById('filter');
    filter?.addEventListener('input', () => {
      const q = filter.value.toLowerCase().trim();
      for (const el of document.querySelectorAll('.poznamka')) {
        el.style.display = !q || el.dataset.text.includes(q) ? '' : 'none';
      }
    });
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import { readProjekty, readWorklog, appendWorklog, writeProjektDalsiKrok, dnes } from '../lib/data.js';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const akcia = form.get('akcia');
  if (akcia === 'worklog') {
    const minuty = Number(String(form.get('minuty') ?? '').trim());
    appendWorklog({
      datum: String(form.get('datum') || dnes()),
      projekt: String(form.get('projekt') ?? '').trim(),
      minuty: Number.isNaN(minuty) ? 0 : minuty,
      popis: String(form.get('popis') ?? '').trim(),
    });
  } else if (akcia === 'dalsi-krok') {
    writeProjektDalsiKrok(String(form.get('slug')), String(form.get('dalsi_krok') ?? '').trim());
  }
  return Astro.redirect('/projekty');
}

const projekty = readProjekty();
const worklog = readWorklog();
---

<Layout title="Projekty">
  <h1>Projekty</h1>

  <div class="mriezka">
    {projekty.map((p) => (
      <div class="panel">
        <strong style="font-size:1.1rem;">{p.nazov}</strong>
        <span class="tag">{p.status}</span>
        <div set:html={marked.parse(p.body)} style="font-size:0.9rem;" />
        <form class="formular" method="post" style="margin-top:0.6rem;">
          <input type="hidden" name="akcia" value="dalsi-krok" />
          <input type="hidden" name="slug" value={p.slug} />
          <label>
            Ďalší krok
            <input type="text" name="dalsi_krok" value={p.dalsi_krok} placeholder="čo je next" />
          </label>
          <button type="submit" style="padding:0.35rem 0.8rem; font-size:0.85rem;">Uložiť</button>
        </form>
      </div>
    ))}
  </div>

  <h2>Zapísať prácu</h2>
  <form class="formular panel" method="post">
    <input type="hidden" name="akcia" value="worklog" />
    <div class="riadok">
      <label>
        Dátum
        <input type="date" name="datum" value={dnes()} required />
      </label>
      <label>
        Projekt
        <select name="projekt" required>
          {projekty.map((p) => <option value={p.nazov}>{p.nazov}</option>)}
        </select>
      </label>
      <label>
        Minúty
        <input type="number" name="minuty" min="0" step="5" placeholder="napr. 90" required />
      </label>
    </div>
    <label>
      Čo si robil
      <input type="text" name="popis" placeholder="napr. Netopier: parser RSS zdrojov" required />
    </label>
    <button type="submit">Zapísať</button>
  </form>

  <h2>Work log</h2>
  {worklog.length === 0 ? (
    <p class="prazdne">Zatiaľ žiadne záznamy o práci.</p>
  ) : (
    <div class="panel" style="overflow-x:auto; padding:0.4rem 0.6rem;">
      <table>
        <thead>
          <tr>
            <th>Dátum</th>
            <th>Projekt</th>
            <th>Čas</th>
            <th>Popis</th>
          </tr>
        </thead>
        <tbody>
          {worklog.map((w) => (
            <tr>
              <td>{w.datum}</td>
              <td>{w.projekt}</td>
              <td>{w.minuty ? `${w.minuty} min` : '—'}</td>
              <td class="muted">{w.popis}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Layout>

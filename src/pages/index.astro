---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import { readDennik, readPoznamky, readProjekty, dnes } from '../lib/data.js';

const datum = dnes();
const dennik = readDennik();
const poznamky = readPoznamky();
const projekty = readProjekty();

const dnesny = dennik.find((z) => z.datum === datum) ?? null;
const poslednych7 = dennik.filter((z) => {
  const rozdiel = (new Date(datum) - new Date(z.datum)) / 86400000;
  return rozdiel >= 0 && rozdiel < 7;
});

const priemer = (pole) => {
  const cisla = pole.filter((x) => typeof x === 'number');
  return cisla.length ? Math.round((cisla.reduce((a, b) => a + b, 0) / cisla.length) * 10) / 10 : null;
};
const priemerKalorie = priemer(poslednych7.map((z) => z.kalorie));
const priemerSpanok = priemer(poslednych7.map((z) => z.spanok));
const cvicenia = poslednych7.filter((z) => z.cvicenie).length;
const meditacie = poslednych7.filter((z) => z.meditacia > 0).length;
---

<Layout title="Prehľad">
  <h1>Prehľad <span class="muted">· {datum}</span></h1>

  <h2>Posledných 7 dní</h2>
  <div class="mriezka">
    <div class="panel stat">
      <div class="cislo">{priemerKalorie ?? '—'}</div>
      <div class="popis">priemer kalórií / deň</div>
    </div>
    <div class="panel stat">
      <div class="cislo">{priemerSpanok != null ? `${priemerSpanok} h` : '—'}</div>
      <div class="popis">priemer spánku</div>
    </div>
    <div class="panel stat">
      <div class="cislo">{cvicenia} / 7</div>
      <div class="popis">dní s cvičením</div>
    </div>
    <div class="panel stat">
      <div class="cislo">{meditacie} / 7</div>
      <div class="popis">dní s meditáciou</div>
    </div>
  </div>

  <h2>Dnešný deň</h2>
  {dnesny ? (
    <div class="panel">
      <div>
        {dnesny.kalorie != null && <span class="chip">kalórie <b>{dnesny.kalorie}</b></span>}
        {dnesny.spanok != null && <span class="chip">spánok <b>{dnesny.spanok} h</b></span>}
        {dnesny.meditacia != null && <span class="chip">meditácia <b>{dnesny.meditacia} min</b></span>}
        {dnesny.cvicenie && <span class="chip">cvičenie <b>{dnesny.cvicenie}</b></span>}
      </div>
      {dnesny.body && <article class="md" set:html={marked.parse(dnesny.body)} />}
    </div>
  ) : (
    <p class="panel prazdne">
      Dnes ešte nie je záznam — vytvor <code>data/dennik/{datum}.md</code> (šablóna: <code>data/dennik/_sablona.md</code>).
    </p>
  )}

  <h2>Projekty</h2>
  <div class="mriezka">
    {projekty.map((p) => (
      <a href={`/projekty/${p.slug}`} class="panel" style="text-decoration:none; color:inherit;">
        <strong>{p.nazov}</strong>
        <span class="tag">{p.status}</span>
        <p class="muted" style="margin:0.5rem 0 0.1rem; font-size:0.82rem;">Ďalší krok</p>
        <p style="margin:0;">{p.dalsi_krok || <span class="prazdne">nezadaný</span>}</p>
      </a>
    ))}
  </div>

  <h2>Posledné poznámky</h2>
  {poznamky.length === 0 ? (
    <p class="prazdne">Zatiaľ žiadne poznámky.</p>
  ) : (
    <ul style="margin:0; padding-left:1.2rem;">
      {poznamky.slice(0, 6).map((p) => (
        <li>
          <a href={`/poznamky/${p.slug}`}>{p.nazov}</a>
          <span class="muted"> · {p.datum}</span>
        </li>
      ))}
    </ul>
  )}
</Layout>
